    {
      "name": "Crud",
      "item": [
        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res =  pm.response.json();",
                  "",
                  "pm.environment.set(\"bookingId\", res.bookingid);",
                  "",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has bookingid\", () => pm.expect(res.bookingid).to.be.a(\"number\"));",
                  "pm.test(\"Echoes request\", () => {",
                  "  pm.expect(res.booking.firstname).to.eql(pm.environment.get(\"firstname\"));",
                  "});",
                  "pm.test(\"Schema\", () => {",
                  "  pm.expect(res.booking).to.have.all.keys(\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\",\"additionalneeds\");",
                  "  pm.expect(res.booking.totalprice).to.be.a(\"number\");",
                  "  pm.expect(res.booking.depositpaid).to.be.a(\"boolean\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.environment.set(\"firstname\", \"Biodun\" + Math.floor(Math.random()*1000));",
                  "pm.environment.set(\"lastname\", \"Tester\" + Math.floor(Math.random()*1000));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\" : \"{{firstname}}\",\n    \"lastname\" : \"{{lastname}}\",\n    \"totalprice\" : 111,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"2018-01-01\",\n        \"checkout\" : \"2019-01-01\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
