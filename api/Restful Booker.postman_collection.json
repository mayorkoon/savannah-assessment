        {
          "name": "Partial Update Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "var req = JSON.parse(pm.request.body.raw);",
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Patched\", () => { ",
                  "    pm.expect(res.firstname).to.eql(req.firstname); ",
                  "    pm.expect(res.totalprice).to.eql(999); ",
                  "    });",
                  "pm.test(\"Unpatched retained\", () => pm.expect(res.lastname).to.eql(pm.environment.get(\"lastname\")));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
